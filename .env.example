# Copy this file to .env.local and adjust values as needed.
# None of these are required to run the app locally — sensible
# defaults are used when they are missing (see README.md).

# Public URL of the site, used for metadata/Open Graph tags and to build
# referral links (https://joinnow.app/?ref=CODE). Defaults to a placeholder
# domain if not set.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (not yet connected — see README.md "Connecter Supabase") ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Email platform (not yet connected — see README.md "Connecter l'emailing") ---
# RESEND_API_KEY=
# WAITLIST_NOTIFICATION_EMAIL=

# --- Analytics (not yet connected — see ANALYTICS.md) ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
